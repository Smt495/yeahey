# 美股每日简报 — 可选环境变量
# 将此文件复制为 .env 并填写

# ── Email 通知 ────────────────────────────────────────────────
# Gmail 用户: 先在 Google 账户 → 安全 → 两步验证 → 应用专用密码 生成16位密码
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com         # 发件人 (同时也是登录账号)
# SMTP_PASS=xxxx xxxx xxxx xxxx    # Google 应用专用密码 (不是登录密码)
# NOTIFY_EMAIL=recipient@example.com  # 收件人 (不填则发给 SMTP_USER 自己)

# ── Telegram Bot 通知 (可选) ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_token
# TELEGRAM_CHAT_ID=your_chat_id

# ── Alpha Vantage API (可选，增强宏观数据) ─────────────────────
# ALPHA_VANTAGE_KEY=your_key

# ── 时区设置 ──────────────────────────────────────────────────
# TIMEZONE=America/New_York   # 默认值
